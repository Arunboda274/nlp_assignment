# ============================================================
# AI Story Continuation System - Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.
# ============================================================

# --- AWS Configuration ---
# Your AWS region (e.g., us-east-1, ap-south-1)
AWS_REGION=us-east-1

# Your SageMaker execution role ARN
# Get this from AWS IAM Console → Roles → SageMakerFullAccess role
SAGEMAKER_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/SageMakerExecutionRole

# S3 bucket to store model artifacts
S3_BUCKET_NAME=your-sagemaker-bucket-name

# SageMaker endpoint name (set after deployment in Phase 9)
SAGEMAKER_ENDPOINT_NAME=ai-story-continuation-endpoint

# --- Inference Mode ---
# Options: "local" (Phase 2-4), "torchserve" (Phase 6-7), "sagemaker" (Phase 9+)
INFERENCE_MODE=local

# --- TorchServe (Phase 6) ---
TORCHSERVE_HOST=localhost
TORCHSERVE_PORT=8080
TORCHSERVE_MODEL_NAME=story_generator
